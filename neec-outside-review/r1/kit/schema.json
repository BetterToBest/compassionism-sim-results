{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "outside reader FINAL object (one unit)",
 "type": "object",
 "required": [
  "clauses",
  "verdict",
  "zero_basis",
  "closed_book"
 ],
 "properties": {
  "clauses": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "n",
     "status",
     "estimate",
     "source"
    ],
    "properties": {
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "status": {
      "enum": [
       "cleared",
       "short",
       "not_shown",
       "moot"
      ]
     },
     "estimate": {
      "type": "string",
      "minLength": 1
     },
     "source": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  },
  "verdict": {
   "enum": [
    1.0,
    0.5,
    0.0
   ]
  },
  "zero_basis": {
   "type": [
    "string",
    "null"
   ]
  },
  "closed_book": {
   "type": "boolean"
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "note": {
   "type": "string"
  }
 },
 "x-rules": [
  "len(clauses) equals the criterion's clause count, n = 1..k in order",
  "verdict 1.0 if and only if every status is cleared or moot (protocol 2.3)",
  "verdict 0.0 requires a non-empty zero_basis; any other verdict requires zero_basis null"
 ]
}
